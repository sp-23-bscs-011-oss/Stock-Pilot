# Base URL the browser uses for API calls.
# Keep "/api" in development: Vite proxies it to the backend (see vite.config.ts).
# For production builds served from another origin, set the full URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Display name used in the UI and page titles
VITE_APP_NAME=StockPilot

# ISO 4217 currency code used to display prices (e.g. USD, EUR, GBP, PKR)
VITE_CURRENCY=USD

# Dev server only: where Vite forwards /api requests (not exposed to the browser)
VITE_DEV_API_PROXY_TARGET=http://localhost:4000
