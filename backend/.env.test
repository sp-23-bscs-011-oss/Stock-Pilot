# Used only by `npm test` (loaded in vitest.config.ts). Points at a separate database
# that the test suite migrates and truncates — never point it at real data.
NODE_ENV=test
LOG_LEVEL=silent
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://stockpilot:stockpilot@localhost:5433/stockpilot_test?schema=public"

SETUP_TOKEN=test-setup-token-0123456789abcdef0123456789
# Fast hashing keeps the suite quick; production enforces >= 10.
BCRYPT_ROUNDS=4
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
