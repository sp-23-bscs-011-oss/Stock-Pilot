# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://stockpilot:stockpilot@localhost:5433/stockpilot?schema=public"

# ─── Authentication ──────────────────────────────────────────────────────────
# One-time secret for creating the first owner at /setup (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Remove it after setup; the endpoint also refuses once any user exists.
SETUP_TOKEN=

# bcrypt cost factor (10–15 in production)
BCRYPT_ROUNDS=12

# Sessions end after SESSION_TTL_HOURS, or sooner after SESSION_IDLE_TIMEOUT_MINUTES of inactivity
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120

# Cookie hardening. COOKIE_SECURE defaults to true in production (and then the cookie uses
# the __Host- prefix). Keep SameSite=strict when the SPA and API share a site; use "none"
# (with COOKIE_SECURE=true) only if they are served from different sites.
# COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Failed sign-in attempts allowed per account+IP per window (per-IP cap is 5x this)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
